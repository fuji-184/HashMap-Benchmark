#!/bin/bash

clear

set -e

# ── auto-detect available f_count features from Cargo.toml ──
AVAILABLE_FEATURES=$(awk '/^\[features\]/{f=1; next} /^\[/{f=0} f && /=/{print $1}' f_count/Cargo.toml | tr '\n' '|' | sed 's/|$//')

echo "=== 1. COMPILING ==="
echo "[i] Available f_count features: $AVAILABLE_FEATURES"

# ── select which f_count variant to use ──
# usage: ./run.sh [software|time|rdtscp]  (default: first feature found)
DEFAULT_FEATURE=$(echo "$AVAILABLE_FEATURES" | cut -d'|' -f1)
F_COUNT_FEATURE="${1:-$DEFAULT_FEATURE}"

if ! echo "|${AVAILABLE_FEATURES}|" | grep -q "|${F_COUNT_FEATURE}|"; then
    echo "Error: unknown feature '$F_COUNT_FEATURE'."
    echo "       Available: $AVAILABLE_FEATURES"
    exit 1
fi

# ── f_count: recompile if .so missing OR src/Cargo.toml newer ──
F_COUNT_LIB="f_count/target/release/libf_count_${F_COUNT_FEATURE}.so"
if [ ! -f "$F_COUNT_LIB" ] || [ "f_count/src/lib.rs" -nt "$F_COUNT_LIB" ] || [ "f_count/Cargo.toml" -nt "$F_COUNT_LIB" ]; then
    echo "[+] Building f_count (feature: $F_COUNT_FEATURE)..."
    cd f_count
    RUSTFLAGS="-C target-cpu=native" cargo build --release -q --features "$F_COUNT_FEATURE"
    cp target/release/libf_count.so "../$F_COUNT_LIB"
    cd ..
else
    echo "[~] f_count ($F_COUNT_FEATURE) already built, skipping."
fi

# point libf_count.so to selected variant
ln -sf "libf_count_${F_COUNT_FEATURE}.so" f_count/target/release/libf_count.so
echo "[~] Using f_count feature: $F_COUNT_FEATURE"

# ── input_generator: recompile if binary missing OR src/Cargo.toml newer ──
if [ ! -f "input_generator/target/release/input_generator" ] || [ "input_generator/src/main.rs" -nt "input_generator/target/release/input_generator" ] || [ "input_generator/Cargo.toml" -nt "input_generator/target/release/input_generator" ]; then
    echo "[+] Building input_generator..."
    cd input_generator
    RUSTFLAGS="-C target-cpu=native" cargo build --release -q
    cd ..
fi

# ── input.bin: generate if missing OR input_generator was just rebuilt ──
if [ ! -f "input.bin" ] || [ "input_generator/target/release/input_generator" -nt "input.bin" ]; then
    echo "[+] Generating input.bin..."   
   cd input_generator
   ./target/release/input_generator
   cd ..
else
    echo "[~] input.bin already exists, skipping generation."
fi

# ── C++ std::unordered_map ──
if [ ! -f "cpp/main" ] || [ "cpp/main.cpp" -nt "cpp/main" ]; then
    echo "[+] Compiling C++ with Clang..."
    cd cpp
    clang++ -O3 -march=native -std=c++23 main.cpp -o main \
        -L../f_count/target/release -lf_count \
        -Wl,-rpath,../f_count/target/release
    cd ..
else
    echo "[~] C++ already compiled, skipping."
fi

# ── C++ Abseil ──
if [ ! -f "cpp/abseil_flat_hashmap" ] || [ "cpp/abseil_flat_hashmap.cpp" -nt "cpp/abseil_flat_hashmap" ]; then
    echo "[+] Compiling C++ Abseil Swiss Table with Clang..."
    cd cpp
    clang++ -O3 -march=native -std=c++23 abseil_flat_hashmap.cpp -o abseil_flat_hashmap \
        $(pkg-config --libs absl_flat_hash_map) \
        -L../f_count/target/release -lf_count \
        -Wl,-rpath,../f_count/target/release
    cd ..
else
    echo "[~] C++ Abseil already compiled, skipping."
fi

# ── Rust std HashMap ──
if [ ! -f "rust/target/release/rust" ] || [ "rust/src/main.rs" -nt "rust/target/release/rust" ]; then
    echo "[+] Compiling Rust..."
    cd rust
    RUSTFLAGS="-C target-cpu=native" cargo build --release -q
    cd ..
else
    echo "[~] Rust already compiled, skipping."
fi

# ── Rust rustc_hash ──
if [ ! -f "rustc_hash/target/release/rust" ] || [ "rustc_hash/src/main.rs" -nt "rustc_hash/target/release/rust" ]; then
    echo "[+] Compiling Rust Rustc_Hash library..."
    cd rustc_hash
    RUSTFLAGS="-C target-cpu=native" cargo build --release -q
    cd ..
else
    echo "[~] Rust Rustc_Hash already compiled, skipping."
fi

# ── Rust ahash ──
if [ ! -f "rust_ahash/target/release/rust" ] || [ "rust_ahash/src/main.rs" -nt "rust_ahash/target/release/rust" ]; then
    echo "[+] Compiling Rust Ahash library..."
    cd rust_ahash
    RUSTFLAGS="-C target-cpu=native" cargo build --release -q
    cd ..
else
    echo "[~] Rust Ahash already compiled, skipping."
fi

# ── Rust hashbrown ──
if [ ! -f "rust_hashbrown/target/release/rust" ] || [ "rust_hashbrown/src/main.rs" -nt "rust_hashbrown/target/release/rust" ]; then
    echo "[+] Compiling Rust Hashbrown library..."
    cd rust_hashbrown
    RUSTFLAGS="-C target-cpu=native" cargo build --release -q
    cd ..
else
    echo "[~] Rust Hashbrown already compiled, skipping."
fi

# ── Zig ──
if [ ! -f "zig/main" ] || [ "zig/src/main.zig" -nt "zig/main" ]; then
    echo "[+] Compiling Zig..."
    sed -i 's|"src/root.zig"|"src/main.zig"|g' zig/build.zig
    cd zig
    zig build-exe src/main.zig -O ReleaseFast -lc \
        -L ../f_count/target/release -lf_count \
        -rpath ../f_count/target/release
    cd ..
else
    echo "[~] Zig already compiled, skipping."
fi

# ── Go ──
if [ ! -f "golang/golang" ] || [ "golang/main.go" -nt "golang/golang" ]; then
    echo "[+] Compiling Go..."
    cd golang
    CGO_ENABLED=1 go build -o golang main.go
    cd ..
else
    echo "[~] Go already compiled, skipping."
fi

echo -e "\n=== 2. RUNNING BENCHMARKS (f_count: $F_COUNT_FEATURE) ===\n"

echo "-----------------------------------"
echo "C++ (std::unordered_map via Clang)"
echo "-----------------------------------"
cd cpp
sleep 1
./main

echo "-----------------------------------"
echo "C++ (absl::flat_hash_map via Clang)"
echo "-----------------------------------"
sleep 1
./abseil_flat_hashmap

cd ../rust
echo -e "\n-----------------------------------"
echo "Rust (std::collections::HashMap)"
echo "-----------------------------------"
sleep 1
./target/release/rust

echo -e "\n-----------------------------------"
echo "Rust (rustc_hash::FxHashMap)"
echo "-----------------------------------"
cd ../rustc_hash
sleep 1
./target/release/rust

echo -e "\n-----------------------------------"
echo "Rust (ahash::AHashMap)"
echo "-----------------------------------"
cd ../rust_ahash
sleep 1
./target/release/rust

echo -e "\n-----------------------------------"
echo "Rust (hashbrown::HashMap)"
echo "-----------------------------------"
cd ../rust_hashbrown
sleep 1
./target/release/rust

echo -e "\n-----------------------------------"
echo "Zig (std::AutoHashMap)"
echo "-----------------------------------"
cd ../zig
sleep 1
./main

echo -e "\n-----------------------------------"
echo "Go (map[int]int)"
echo "-----------------------------------"
cd ../golang
sleep 1
./golang

cd ..
echo -e "\n=== Done (f_count: $F_COUNT_FEATURE) ==="